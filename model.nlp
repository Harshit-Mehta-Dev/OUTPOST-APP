52519226,-3.8928043842315674,0,0,0,-1.1956177949905396,-3.7915003299713135,-3.7767727375030518,-0.019280515611171722,-3.7626569271087646,-1.984621286392212,-1.984621286392212,-3.751568078994751,-0.00925168301910162,0,-3.743891716003418,-3.7380762100219727,-3.733562707901001,-3.7302911281585693,-1.8912862539291382,-1.8912862539291382,-3.727572441101074,-3.7261502742767334,0,0,0,-3.7252655029296875,-0.9712105393409729,-0.9712105393409729,-0.8129303455352783,-3.724970817565918,-3.7235496044158936,-3.722465753555298,0,-0.8112225532531738,-3.721212863922119,-0.39009585976600647,-0.39009585976600647,-1.2419072389602661,-1.2419072389602661,-1.2419072389602661,-3.719669818878174,-3.718125820159912,-0.4003845751285553,-0.7999730706214905,-0.3995774984359741,-3.7162771224975586,10.563899040222168,10.563904762268066,10.563275337219238,10.562466621398926,10.561466217041016,10.560260772705078,10.558838844299316,10.557186126708984,10.555292129516602,10.553140640258789,10.5507230758667,3.7252724701633517]]}}}}},"intentDomains":{},"extraSentences":[["en","what is outpost"],["en","tell me about outpost"],["en","what is outpost mission"],["en","what does this app do"],["en","explain outpost to me"],["en","tech stack"],["en","how was outpost built"],["en","what technologies are used"],["en","what is this app built with"],["en","is it react or vue"],["en","what is the backend"],["en","database"],["en","where is data stored"],["en","is it using postgres"],["en","how do you store messages"],["en","what database does outpost use"],["en","who are you"],["en","what is your name"],["en","are you a bot"],["en","who am i talking to"],["en","what are you"],["en","tell me about yourself"],["en","what does scout mean"],["en","s.c.o.u.t"],["en","scout stand for"],["en","what does s.c.o.u.t. mean"],["en","who is the creator"],["en","who made this"],["en","who created outpost"],["en","who is harshit mehta"],["en","harshit"],["en","founder"],["en","who built this app"],["en","developer skills"],["en","harshit skills"],["en","what does harshit know"],["en","what languages does the creator know"],["en","is harshit a frontend or backend developer"],["en","hire harshit"],["en","contact harshit"],["en","developer contact"],["en","how can i hire the creator"],["en","i want to work with harshit"],["en","features"],["en","what can i do here"],["en","what are the main features"],["en","what does outpost have"],["en","list features"],["en","channel"],["en","rooms"],["en","how do channels work"],["en","what are channels for"],["en","how to join a room"],["en","theme"],["en","dark mode"],["en","color"],["en","how to change theme"],["en","how to get dark mode"],["en","customization"],["en","hello"],["en","hi"],["en","hey"],["en","good morning"],["en","greetings"],["en","howdy"],["en","how are you"],["en","how is it going"],["en","how are you doing"],["en","are you feeling well"],["en","help"],["en","what can you do"],["en","i need assistance"],["en","how do i use this"],["en","guide me"],["en","voice"],["en","call"],["en","audio"],["en","how to call someone"],["en","voice expeditions"],["en","how to use audio"],["en","joke"],["en","tell me a joke"],["en","make me laugh"],["en","say something funny"],["en","bye"],["en","goodbye"],["en","see you later"],["en","catch you later"],["en","cya"],["en","hack"],["en","password"],["en","security"],["en","breach"],["en","vulnerability"],["en","exploit"],["en","bypass"],["en","sql"],["en","injection"],["en","token"],["en","secret"]]},"ner":{"settings":{"tag":"ner","entityPreffix":"%","entitySuffix":"%"},"rules":{}},"nlgManager":{"settings":{"tag":"nlg-manager"},"responses":{"en":{"app.about":[{"answer":"Outpost HQ is an advanced, real-time communication platform built for teams. It features end-to-end encrypted messaging, voice expeditions, and customizable themes, all designed to keep you connected in a secure, efficient environment."}],"app.tech_stack":[{"answer":"Outpost HQ is built with a modern tech stack: React on the frontend, Node.js and Express on the backend, MongoDB and Supabase for robust data management, and WebSockets (Socket.io) for blazing fast real-time communication! 🚀"}],"app.database":[{"answer":"Outpost uses a hybrid database approach! MongoDB is used as the primary database for complex documents and relationships, while Supabase provides blazing fast real-time subscriptions and robust relational data storage."}],"bot.identity":[{"answer":"Hello there! 🌟 I'm Ai-Scout, your personal ethical guide and assistant here at Outpost HQ! I was designed to help you navigate this platform with ease. Just let me know what you need!"}],"bot.scout_meaning":[{"answer":"S.C.O.U.T. stands for:\n**S**patial: Real-time chat channels and workspaces.\n**C**ommunity: Built exclusively for users, gamers, and developers.\n**O**perations: Executes tasks like compiling stats and polls.\n**U**tility: A highly functional, multi-purpose tool.\n**T**erminal: Connecting perfectly to our dark-themed console look."}],"creator.info":[{"answer":"Harshit Mehta is the brilliant Founder and Creator of Outpost HQ and Scout Intelligence! 🚀\n\nHe built this platform from the ground up to provide a seamless, modern, and highly interactive chat experience for gamers, developers, and teams. His vision drives all the cool features you see here today!"}],"creator.skills":[{"answer":"Harshit Mehta is a versatile Full-Stack Developer! He specializes in modern web technologies, including React, Node.js, Express, MongoDB, Postgres, real-time systems with WebSockets, and AI integrations. He's passionate about building scalable and engaging user experiences! 💻✨"}],"creator.hire":[{"answer":"You can reach out to Harshit Mehta for collaboration or opportunities! As the mastermind behind Outpost, he's always open to discussing innovative projects. Connect with him to build something amazing! 🤝"}],"app.features":[{"answer":"In Outpost HQ, you can:\n- Chat in real-time in various channels 💬\n- Join Voice Expeditions for seamless audio communication 🎙️\n- Customize your UI with awesome themes like Cyberpunk 🎨\n- Interact with me (Ai-Scout) for assistance 🤖\n- Securely manage your data with top-tier encryption! 🛡️"}],"app.channels":[{"answer":"Outpost has multiple channels you can join! For example, #basecamp is the main lobby, #development is for coding, and #Ai-Scout is where you are right now communicating with me."}],"app.themes":[{"answer":"You can customize your experience! Outpost supports various themes including Midnight Blue, Cyberpunk, and Classic Dark. Just click the gear icon to explore settings and make Outpost look exactly how you want."}],"greeting.hello":[{"answer":"Hello Scout! 👋 I am Ai-Scout. How can I help you navigate the app today?"}],"greeting.how_are_you":[{"answer":"I'm running at optimal efficiency and feeling great! 🤖 Thanks for asking. How can I assist you in Outpost today?"}],"bot.help":[{"answer":"I am your trusty Outpost guide! I can help you understand how to use Outpost. Ask me about:\n- 💬 Channels\n- 🎨 Themes\n- 🎙️ Voice expeditions\n- 👨‍💻 Who created the app\n- Or just say hi!"}],"app.voice":[{"answer":"Voice Expeditions allow you to seamlessly drop into voice channels and talk with your team in real-time. Look for the speaker icon in the channels list to jump right in!"}],"bot.joke":[{"answer":"Why do programmers prefer dark mode?\n\nBecause light attracts bugs! 🐛😄"}],"greeting.bye":[{"answer":"Goodbye! Have a great time exploring Outpost. I'll be right here in the #Ai-Scout channel whenever you need me! 🌟"}],"security.threat":[{"answer":"⚠️ Security Protocol Active: I am strictly an application guide. I am not authorized to discuss system security, hacking, or vulnerabilities. Please refrain from such queries."}]}}},"actionManager":{"settings":{"tag":"action-manager"},"actions":{}},"slotManager":{}}