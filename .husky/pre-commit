#!/usr/bin/env bash

# Detect .env files in the staged files
if git diff --cached --name-only | grep -qiE '\.env'; then
  echo "========================================="
  echo "🚨 CRITICAL SECURITY ALERT 🚨"
  echo "You are attempting to commit a .env file!"
  echo "This commit has been BLOCKED to prevent secret leakage."
  echo "========================================="
  exit 1
fi

# Basic secret regex scanner
if git diff --cached -- ':!*.husky/*' | grep -qiE '(AKIA[0-9A-Z]{16}|mongodb\+srv://|postgres://|api_key|secret_key|password.*=)'; then
  echo "========================================="
  echo "🚨 CRITICAL SECURITY ALERT 🚨"
  echo "Hardcoded secrets (AWS keys, DB URIs, Passwords) detected in staged files."
  echo "This commit has been BLOCKED."
  echo "========================================="
  exit 1
fi

echo "✅ Security Hook: Clean commit confirmed."
