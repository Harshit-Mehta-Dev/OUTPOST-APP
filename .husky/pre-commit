#!/usr/bin/env bash

# Detect .env files in the staged files
if git diff --cached --name-only | grep -qiE '\.env$|\.env\.local$|\.env\.production$'; then
  echo "========================================="
  echo "🚨 CRITICAL SECURITY ALERT 🚨"
  echo "You are attempting to commit a .env file!"
  echo "This commit has been BLOCKED to prevent secret leakage."
  echo "========================================="
  exit 1
fi

# Specific secret regex scanner (AWS, DB URIs, Stripe, JWT, GitHub Tokens)
if git diff --cached -- ':!*.husky/*' | grep -qiE '(AKIA[0-9A-Z]{16}|mongodb\+srv://|postgres://|sk_live_[0-9a-zA-Z]+|eyJ[A-Za-z0-9-_=]+\.[A-Za-z0-9-_=]+\.?[A-Za-z0-9-_.+/=]*|ghp_[a-zA-Z0-9]{36})'; then
  echo "========================================="
  echo "🚨 CRITICAL SECURITY ALERT 🚨"
  echo "Hardcoded secrets (AWS keys, DB URIs, Passwords) detected in staged files."
  echo "This commit has been BLOCKED."
  echo "========================================="
  exit 1
fi

echo "✅ Security Hook: Clean commit confirmed."
