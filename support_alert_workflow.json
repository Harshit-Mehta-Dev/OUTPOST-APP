{
  "name": "Support Alert to Gmail",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-alert",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook (Support Alert)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "support-alert-webhook"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "your.email@gmail.com",
        "subject": "={{ '🚨 New Support Request from: ' + $json.body.userEmail }}",
        "message": "={{ 'A user has submitted a support request via the Outpost App.\\n\\nUser Email: ' + $json.body.userEmail + '\\n\\nMessage:\\n' + $json.body.message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [500, 300],
      "credentials": {
        "gmailOAuth2": {
          "id": "1",
          "name": "Gmail account"
        }
      }
    }
  ],
  "connections": {
    "Webhook (Support Alert)": {
      "main": [
        [
          {
            "node": "Send Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
