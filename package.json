    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.17.0",
    "mongodb": "^4.17.2",
